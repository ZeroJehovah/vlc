@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+package org.videolan.vlc.util;
+
+import java.util.LinkedList;
+import java.util.List;
+import java.util.ListIterator;
+
+/** A bounded UI preview; the service retains the full log for file export. */
+public final class DebugLogSnapshot {
+    private DebugLogSnapshot() {}
+
+    public static List<String> forBinder(List<String> logs) {
+        // Binder has a shared transaction buffer. Leave ample room for other
+        // transactions, Parcel framing and UTF-16 string encoding.
+        int remainingCharacters = 32 * 1024;
+        LinkedList<String> preview = new LinkedList<>();
+        ListIterator<String> iterator = logs.listIterator(logs.size());
+        while (iterator.hasPrevious() && preview.size() < 200 && remainingCharacters > 0) {
+            String line = iterator.previous();
+            int length = Math.min(line.length(), Math.min(2048, remainingCharacters));
+            if (length < line.length()) {
+                line = line.substring(0, length);
+            }
+            preview.addFirst(line);
+            remainingCharacters -= length;
+        }
+        return preview;
+    }
+}
